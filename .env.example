# Copiá la URL del Transaction pooler (puerto 6543) desde Connect > ORM > Drizzle.
# Reemplazá el marcador con la contraseña de la base y nunca subas .env.local.
DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres"

# Connect > Framework > Next.js. La publishable key puede exponerse al navegador.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_REPLACE_ME"

# Única cuenta habilitada para administrar KHORA.
KHORA_ALLOWED_EMAIL="paulazarlenga@gmail.com"
